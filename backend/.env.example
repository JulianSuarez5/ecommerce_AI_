# =============================================================================
# CENTROVA — Variables de Entorno (Backend)
# =============================================================================
# Copia este archivo como .env o exporta las variables en tu sistema.
# Spring Boot lee estas variables automáticamente si están en el entorno.
# NO subas .env al repositorio.
# =============================================================================

# --- Base de Datos (PostgreSQL / Supabase) ---
# Reemplaza con tu host y contraseña de Supabase
# Usar Session Pooler (IPv4) del Dashboard de Supabase
DB_URL=jdbc:postgresql://aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=TuPasswordDeSupabase

# --- JWT ---
# Generar con: openssl rand -hex 32
JWT_SECRET=genera-un-secreto-de-256-bits-con-openssl-rand-32-hex

# --- Correo SMTP ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-app-password-de-gmail

# --- APIs Externas ---
GROQ_API_KEY=tu-groq-api-key
TAVILY_API_KEY=tu-tavily-api-key

# --- Wompi (Pagos Colombia) ---
WOMPI_PUBLIC_KEY=pub_test_siRFrZxFiPuJWucTjcQbqPxnGlh8rvcd
WOMPI_PRIVATE_KEY=prv_test_TVAdSufWq1ZIy7YGDSsVWTRACkNZ4vP0
WOMPI_INTEGRITY_SECRET=test_integrity_SdmQaByby9qdfKwODfH6UkciMHj4Arrc
WOMPI_EVENT_SECRET=test_events_xvT39RdpfrJLvvKjICB70M91BUV1DwGb
WOMPI_BASE_URL=https://sandbox.wompi.co
WOMPI_REDIRECT_URL=http://localhost:3000/pedido-confirmado

# --- PayPal ---
PAYPAL_CLIENT_ID=tu-paypal-client-id
PAYPAL_CLIENT_SECRET=tu-paypal-client-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Hibernate ---
# Usar 'update' en desarrollo, 'validate' en producción
HIBERNATE_DDL_AUTO=validate

# --- Logging ---
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_SQL=WARN
LOG_LEVEL_HIBERNATE=WARN
