@startuml CENTROVA - Diagrama de Clases (Entidades)
' ─────────────────────────────────────────────────
' 1. DIAGRAMA DE CLASES - ENTIDADES JPA
' ─────────────────────────────────────────────────
skinparam backgroundColor #FEFEFE
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
  FontSize 11
  HeaderBackgroundColor #e8c97e
  ArrowColor #e8c97e
}
skinparam arrow {
  Color #e8c97e
}

entity "User" as User {
  + id: Long
  + nombre: String
  + segundoNombre: String
  + apellido: String
  + segundoApellido: String
  + email: String [unique]
  + password: String
  + telefono: String
  + activo: boolean
  + ultimoAcceso: LocalDateTime
  --
  + getNombreCompleto(): String
}

entity "Role" as Role {
  + id: Long
  + nombre: String [unique]
}

entity "Address" as Address {
  + id: Long
  + alias: String
  + calle: String
  + numero: String
  + ciudad: String
  + departamento: String
  + codigoPostal: String
  + referencia: String
  + esPrincipal: boolean
}

entity "Category" as Category {
  + id: Long
  + nombre: String [unique]
  + descripcion: String
  + activo: boolean
}

entity "Brand" as Brand {
  + id: Long
  + nombre: String [unique]
  + descripcion: String
  + activo: boolean
}

entity "Product" as Product {
  + id: Long
  + nombre: String
  + descripcion: String
  + descripcionCorta: String
  + precio: BigDecimal
  + precioOferta: BigDecimal
  + stock: int
  + stockMinimo: int
  + sku: String [unique]
  + imagenPrincipal: String
  + modelo3dUrl: String
  + colores: String
  + especificaciones: String
  + tags: String
  + destacado: boolean
  + activo: boolean
  + fechaCreacion: LocalDateTime
  --
  + isStockBajo(): boolean
}

entity "ProductImage" as ProductImage {
  + id: Long
  + url: String
  + orden: int
}

entity "Cart" as Cart {
  + id: Long
}

entity "CartItem" as CartItem {
  + id: Long
  + cantidad: int
  + precioUnitario: BigDecimal
  --
  + getSubtotal(): BigDecimal
}

entity "Order" as Order {
  + id: Long
  + estado: OrderStatus [PENDIENTE,CONFIRMADO,ENVIADO,ENTREGADO,CANCELADO]
  + subtotal: BigDecimal
  + costoEnvio: BigDecimal
  + total: BigDecimal
  + notas: String
  + fechaPedido: LocalDateTime
  + fechaEnvio: LocalDateTime
  + fechaEntrega: LocalDateTime
  + numeroSeguimiento: String
}

entity "OrderDetail" as OrderDetail {
  + id: Long
  + cantidad: int
  + precioUnitario: BigDecimal
  + subtotal: BigDecimal
}

entity "OrderStatusHistory" as OrderStatusHistory {
  + id: Long
  + estado: String
  + comentario: String
  + fecha: LocalDateTime
}

entity "Payment" as Payment {
  + id: Long
  + metodo: String
  + estado: String
  + monto: BigDecimal
  + referenciaExterna: String [unique]
  + fechaPago: LocalDateTime
  + fechaCreacion: LocalDateTime
}

entity "InventoryMovement" as InventoryMovement {
  + id: Long
  + tipo: String [ENTRADA,SALIDA,AJUSTE]
  + cantidad: int
  + motivo: String
  + fecha: LocalDateTime
}

entity "PurchaseOrder" as PurchaseOrder {
  + id: Long
  + estado: PurchaseOrderStatus
  + total: BigDecimal
  + fechaPedido: LocalDateTime
  + fechaEsperada: LocalDateTime
  + notas: String
}

entity "PurchaseOrderItem" as PurchaseOrderItem {
  + id: Long
  + cantidad: int
  + precioUnitario: BigDecimal
  + subtotal: BigDecimal
}

entity "Supplier" as Supplier {
  + id: Long
  + nombre: String
  + contacto: String
  + email: String
  + telefono: String
  + direccion: String
  + activo: boolean
}

entity "PasswordResetToken" as PasswordResetToken {
  + id: Long
  + token: String [unique]
  + fechaExpiracion: LocalDateTime
  + usado: boolean
}

' ─── Relaciones ───
User "1" -- "*" Address : tiene
User "*" -- "*" Role : tiene
User "1" -- "1" Cart : posee
User "1" -- "*" Order : realiza

Cart "1" -- "*" CartItem : contiene
CartItem "*" -- "1" Product : referencia

Order "1" -- "*" OrderDetail : contiene
OrderDetail "*" -- "1" Product : snapshot
Order "1" -- "1" Payment : tiene
Order "1" -- "*" OrderStatusHistory : historial

Product "*" -- "1" Category : pertenece
Product "*" -- "1" Brand : tiene
Product "1" -- "*" ProductImage : imagenes
Product "1" -- "*" InventoryMovement : movimientos

PurchaseOrder "1" -- "*" PurchaseOrderItem : contiene
PurchaseOrderItem "*" -- "1" Product : referencia
PurchaseOrder "*" -- "1" Supplier : Proveedor

User "1" -- "*" PasswordResetToken : tokens

@enduml

' ═══════════════════════════════════════════════
' 2. DIAGRAMA DE CASOS DE USO
' ═══════════════════════════════════════════════
@startuml CENTROVA - Casos de Uso
skinparam backgroundColor #FEFEFE
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
  FontSize 11
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontColor #1a1a1a
}

' === Actores ===
actor ":Cliente" as Cliente
actor ":Admin" as Admin
actor ":PayPal" as Paypal
