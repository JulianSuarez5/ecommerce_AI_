skinparam backgroundColor #FEFEFE
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
  FontSize 11
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
  FontSize 10
}
skinparam arrow {
  Color #686868
}

package "Frontend (React + Vite)" as FE {
  rectangle "pages/" as FE_PAGES
  rectangle "components/" as FE_COMP
  rectangle "context/" as FE_CTX
  rectangle "hooks/" as FE_HOOKS
  rectangle "api/" as FE_API
  rectangle "utils/" as FE_UTILS
}

package "API REST (HTTP/JSON)" as API

package "Backend (Spring Boot 3.2)" as BE {
  package "Controller" as CTRL {
  }

  package "Service" as SVC {
  }

  package "Event" as EVT {
  }

  package "Repository" as REPO {
  }

  package "Entity" as ENT {
  }

  package "Security" as SEC {
  }

  package "Config & DTOs" as CFG {
  }
}

rectangle "Base de Datos\nSQL Server" as DB

rectangle "Servicios Externos" as EXT {
  rectangle "PayPal" as PP
  rectangle "Gmail SMTP" as GM
  rectangle "Anthropic Claude" as AI
}

' ── Conexiones ──
FE --> API : HTTP/JSON
API --> CTRL : Spring MVC

CTRL --> SVC : llama
SVC --> REPO : consulta
SVC --> EVT : publica
EVT ..> SVC : escucha
