  usecase "Recuperar contraseña" as UC3
  usecase "Buscar productos" as UC4
  usecase "Filtrar por categoría" as UC5
  usecase "Ver detalle de producto" as UC6
  usecase "Ver producto en 3D" as UC7
  usecase "Agregar al carrito" as UC8
  usecase "Gestionar carrito" as UC9
  usecase "Realizar checkout" as UC10
  usecase "Pagar con PayPal" as UC11
  usecase "Ver historial de pedidos" as UC12
  usecase "Ver detalle de pedido" as UC13
}

' === Paquete Administrador (vertical) ===
rectangle "Administrador" as AdminRect {
  usecase "Gestionar productos" as UC20
  usecase "Gestionar categorías" as UC21
  usecase "Gestionar marcas" as UC22
  usecase "Gestionar proveedores" as UC23
  usecase "Gestionar usuarios" as UC24
  usecase "Gestionar pedidos" as UC25
  usecase "Cambiar estado pedido" as UC26
  usecase "Gestionar inventario" as UC27
  usecase "Gestionar compras" as UC28
  usecase "Ver dashboard" as UC29
  usecase "Ver reportes" as UC30
  usecase "Chat IA Insights" as UC31
  usecase "Subir modelo 3D" as UC32
}

' === Conexiones Cliente ===
Cliente -down-> UC1
Cliente -down-> UC2
Cliente -down-> UC3
Cliente -down-> UC4
Cliente -down-> UC5
Cliente -down-> UC6
Cliente -down-> UC7
Cliente -down-> UC8
Cliente -down-> UC9
Cliente -down-> UC10
Cliente -down-> UC11
Cliente -down-> UC12
Cliente -down-> UC13

' === Conexiones Admin ===
Admin -down-> UC20
Admin -down-> UC21
Admin -down-> UC22
Admin -down-> UC23
Admin -down-> UC24
Admin -down-> UC25
Admin -down-> UC26
Admin -down-> UC27
Admin -down-> UC28
Admin -down-> UC29
Admin -down-> UC30
Admin -down-> UC31
Admin -down-> UC32

' === Interacciones del sistema ===
UC11 --> Paypal : procesa pago
UC3 --> Email : envía token
UC11 --> Email : confirma pago
UC26 --> Email : notifica cambio

' === Mejora de layout vertical ===
left to right direction
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 40

@enduml

' ═══════════════════════════════════════════════
' 3. DIAGRAMA DE ACTIVIDADES - FLUJO DE CHECKOUT
' ═══════════════════════════════════════════════
@startuml CENTROVA - Flujo de Checkout
skinparam backgroundColor #FEFEFE
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
}
skinparam arrow {
  Color #e8c97e
}

start
:Usuario navega catálogo;
:Agrega productos al carrito;

repeat
  :Revisa carrito;
  :¿Desea modificar cantidades?;
  if () then (sí)
    :Actualiza cantidades en carrito;
    :Sistema valida stock disponible;
  else (no)
  endif
repeat while (¿Seguir comprando?) is (sí)
->no;

:Inicia checkout;
:Selecciona dirección de envío;
:Selecciona método de pago;

if (PayPal?) then (sí)
  :Redirige a PayPal;
  :Usuario autoriza pago en PayPal;
  :PayPal retorna orderId;
else (transferencia/Tarjeta)
  :Continúa sin PayPal;
endif

:Sistema verifica idempotencia del pago;
if (Pago duplicado?) then (sí)
  :Rechaza con error;
  stop
endif

:Valida stock nuevamente (race condition);
:Sistema descuenta stock;
:Registra pago;
:Guarda pedido con estado PENDIENTE/CONFIRMADO;

:Registra historial de estado;
:Limpia carrito del usuario;

:Publica evento OrderCreated;
:EventListener envía email de confirmación;

:Retorna resumen del pedido;
stop

@enduml

' ═══════════════════════════════════════════════
