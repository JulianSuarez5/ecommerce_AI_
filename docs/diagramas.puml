@enduml

' ═══════════════════════════════════════════════
' 5. DIAGRAMA DE SECUENCIA - CHECKOUT CON PAYPAL
' ═══════════════════════════════════════════════
@startuml CENTROVA - Secuencia Checkout PayPal
skinparam backgroundColor #FEFEFE
skinparam participant {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
}
skinparam arrow {
  Color #e8c97e
}

actor "Cliente" as C
participant "Frontend\nReact" as FE
participant "ProductoController" as CTRL_PROD
participant "PedidoController" as CTRL_ORD
participant "PedidoServiceImpl" as SVC
participant "PaymentRepository" as PAY_REPO
participant "ProductRepository" as PROD_REPO
participant "OrderRepository" as ORD_REPO
participant "EventPublisher" as EVT
participant "PayPal" as PP
participant "EmailService" as EMAIL

C -> FE: 1. Agrega producto al carrito
FE -> CTRL_PROD: GET /productos
CTRL_PROD --> FE: Productos disponibles

C -> FE: 2. Inicia checkout
FE -> FE: Valida carrito no vacío

C -> FE: 3. Selecciona dirección
C -> FE: 4. Hace clic en "Pagar con PayPal"
FE -> PP: 5. Crea orden PayPal
PP --> FE: 6. OrderID

C -> FE: 7. Confirma pago
FE -> CTRL_ORD: POST /pedidos/checkout\n{ paypalOrderId, items, addressId }

CTRL_ORD -> SVC: checkout(userId, request)

SVC -> PAY_REPO: 8. existsByReferenciaExterna(id)
PAY_REPO --> SVC: false (no duplicado)

SVC -> PROD_REPO: 9. findById(productId)
PROD_REPO --> SVC: Producto

SVC -> SVC: 10. Valida stock >= cantidad

SVC -> PROD_REPO: 11. Descuenta stock
PROD_REPO --> SVC: stock actualizado

SVC -> SVC: 12. Calcula subtotal, envío, total

SVC -> ORD_REPO: 13. save(pedido con Payment)
ORD_REPO --> SVC: Pedido guardado

SVC -> SVC: 14. registrarHistorial(CONFIRMADO)

SVC -> EVT: 15. publish(OrderCreatedEvent)
EVT -> EMAIL: 16. Envía confirmación
EMAIL --> C: Email de confirmación

SVC --> CTRL_ORD: PedidoResponse
CTRL_ORD --> FE: { id, estado, total, ... }
FE --> C: 17. Pantalla de confirmación

@enduml

' ═══════════════════════════════════════════════
' 6. DIAGRAMA DE DESPLIEGUE
' ═══════════════════════════════════════════════
@startuml CENTROVA - Despliegue
skinparam backgroundColor #FEFEFE
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
}
skinparam database {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
}
skinparam cloud {
  BackgroundColor #FFFFFF
  BorderColor #e8c97e
  FontColor #1a1a1a
}
skinparam arrow {
  Color #e8c97e
}

node "Servidor Frontend\n(Vite / CDN)" as FE_NODE {
  [SPA React]\n(puerto 5173 dev\n/ 80 prod)
}

node "Servidor Backend\n(Java 21 / Spring Boot)" as BE_NODE {
  [API REST]\n(puerto 8080)
  [Modelos 3D]\n(/modelos/**)
}

database "SQL Server Express" as DB_NODE {
  [tablas:\nusers, products,\norders, payments,\ncategories, etc.]
}

cloud "PayPal" as PAYPAL_CLOUD {
  [PayPal API]\n(sandbox / live)
}

cloud "Gmail SMTP" as SMTP_CLOUD {
  [Email Service]
}

cloud "Anthropic Claude" as CLAUDE_CLOUD {
  [AI Insights API]
}

node "Cliente" as CLIENT {
  [Navegador Web\n(Chrome, Firefox, Edge)]
}

CLIENT --> FE_NODE : HTTP/HTTPS
FE_NODE --> BE_NODE : HTTP/JSON (API calls)
BE_NODE --> DB_NODE : JDBC (puerto 1433)
BE_NODE --> PAYPAL_CLOUD : HTTPS (REST)
BE_NODE --> SMTP_CLOUD : SMTP (587)
BE_NODE --> CLAUDE_CLOUD : HTTPS (REST)
FE_NODE ..> PAYPAL_CLOUD : PayPal JS SDK\n(redirect)

@enduml
